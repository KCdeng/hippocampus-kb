    "kb/m3embed.py": [
      ["os.environ.get(\"M3_ONNX_DIR\", r\"D:\\<你的模型目录>\")", "os.environ.get(\"M3_ONNX_DIR\", os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), \"models\", \"bge-m3-onnx\"))"]
